# =====================================================================
# NovaScore — configuration de la base de données
# 1. Copier ce fichier en le renommant « .env » (dans le même dossier).
# 2. Renseigner le mot de passe du super-utilisateur postgres (choisi lors de l'installation de PostgreSQL).
#    Les trois mots de passe des rôles NovaScore sont des valeurs de démonstration : à changer en production.
# Le fichier .env contient des mots de passe : il ne doit jamais être partagé ni versionné (voir .gitignore).
# =====================================================================

# Serveur PostgreSQL
PG_HOTE=localhost
PG_PORT=5432
# prefer en local ; require pour une base hébergée en ligne
PG_SSLMODE=prefer

# Super-utilisateur PostgreSQL : mot de passe choisi lors de l'installation de PostgreSQL.
# Utilisé uniquement par installer_base.py pour créer la base et les rôles.
PG_SUPERUTILISATEUR=postgres
PG_SUPERUTILISATEUR_MDP=<mot de passe de postgres>

# Base NovaScore et mots de passe des trois rôles créés par l'installation
NOVASCORE_BASE=novascore
NOVASCORE_ADMIN_MDP=NsAdmin_2026!
NOVASCORE_APP_MDP=NsApp_2026!
NOVASCORE_LECTURE_MDP=NsLecture_2026!

# Assistant d'explication (LLM Claude) — facultatif.
# Sans clé, l'application affiche une explication automatique (règles fixes) à la place.
# Clé à créer sur https://console.anthropic.com (rubrique API Keys).
ANTHROPIC_API_KEY=
ASSISTANT_MODELE=claude-haiku-5-5
