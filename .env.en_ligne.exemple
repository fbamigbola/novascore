# =====================================================================
# NovaScore — configuration de la base EN LIGNE (Neon), utilisée par :
#   python installer_base.py --en-ligne
# 1. Copier ce fichier en « .env.en_ligne » (même dossier).
# 2. Recopier l'hôte et le mot de passe affichés par Neon (Dashboard → Connect).
#    Utiliser l'hôte SANS « -pooler » (connexion directe).
# Ce fichier contient des mots de passe : jamais partagé ni versionné.
# =====================================================================
PG_HOTE=<ep-xxxx.eu-central-1.aws.neon.tech>
PG_PORT=5432
PG_SSLMODE=require

# Compte propriétaire fourni par Neon (pas super-utilisateur) et sa base par défaut
PG_SUPERUTILISATEUR=neondb_owner
PG_SUPERUTILISATEUR_MDP=<mot de passe affiché par Neon>
PG_BASE_MAINTENANCE=neondb

# Base NovaScore et mots de passe des trois rôles (différents de ceux du poste local)
NOVASCORE_BASE=novascore
NOVASCORE_ADMIN_MDP=<mot de passe robuste>
NOVASCORE_APP_MDP=<mot de passe robuste>
NOVASCORE_LECTURE_MDP=<mot de passe robuste>
